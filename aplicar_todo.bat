powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%ZIP%', [Convert]::FromBase64String((Get-Content '%B64%' -Raw))); Expand-Archive -Path '%ZIP%' -DestinationPath '%PROYECTO%' -Force"
if errorlevel 1 goto errorcopiar
del "%B64%" >nul 2>&1
del "%ZIP%" >nul 2>&1

cd /d "%PROYECTO%"

echo.
echo ==== 3. Compilando ====
dotnet build
if errorlevel 1 goto errorcompilar

echo.
echo ==== 4. Creando la migracion ====
dotnet ef migrations add Inicial --project src/ControlAcademico.Datos --startup-project src/ControlAcademico.Web
if errorlevel 1 goto errormigracion

echo.
echo ==== 5. Creando la base de datos ====
dotnet ef database update --project src/ControlAcademico.Datos --startup-project src/ControlAcademico.Web
if errorlevel 1 goto errorbase

echo.
echo ==== LISTO. Abre SSMS y busca la base ControlAcademicoDB ====
pause
exit /b

:sinproyecto
echo No encuentro el proyecto en %PROYECTO%
echo Revisa que la carpeta exista y tenga el archivo ControlAcademico.sln
pause
exit /b

:errorcopiar
echo.
echo ERROR al copiar los archivos. Toma captura de lo que sale arriba y mandamela.
pause
exit /b

:errorcompilar
echo.
echo ERROR al compilar. Toma captura de lo que sale arriba en rojo y mandamela.
pause
exit /b

:errormigracion
echo.
echo ERROR al crear la migracion. Toma captura de lo que sale arriba y mandamela.
pause
exit /b

:errorbase
echo.
echo ERROR al crear la base de datos. Toma captura de lo que sale arriba y mandamela.
pause
exit /b
